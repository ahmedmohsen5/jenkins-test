pipeline{
    agent{
        label "agent2"
    }
    stages{
        stage("checkout"){
             steps{
                echo "========checking out code========"
            }   
        }
    
        stage("install dependencies"){
             steps{
                sh 'npm ci'
            }   
        }
        stage('build'){
             steps{
                sh 'npm run build --if-present'
            }   
        }
        stage('test'){
             steps{
                sh 'npm test'
            }   
        }
    }
    post{
        always{
            echo "the pipeline has completed"
        }
        success{
            echo "the pipeline has succeeded"
        }
        failure{
            echo "the pipeline has failed"
        }
    }
}